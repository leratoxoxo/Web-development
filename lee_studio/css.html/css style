/* =========================================
   LEE'S STUDIO
   Part 2 - CSS Styling & Responsive Design
   ========================================= */


/* =========================================
   CSS RESET
   ========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


/* =========================================
   ROOT VARIABLES
   ========================================= */

:root {
    --black: #0B0B0B;
    --charcoal: #1C1C1C;
    --grey: #555555;
    --light-grey: #D9D9D9;
    --white: #FFFFFF;

    --container-width: 1200px;

    --heading-font: Georgia, "Times New Roman", serif;
    --body-font: Arial, Helvetica, sans-serif;
}


/* =========================================
   BASE STYLING
   ========================================= */

html {
    scroll-behavior: smooth;
}

body {
    background-color: var(--black);
    color: var(--white);
    font-family: var(--body-font);
    font-size: 1rem;
    line-height: 1.6;
}


/* =========================================
   GENERAL ELEMENTS
   ========================================= */

img {
    max-width: 100%;
    height: auto;
    display: block;
}

a {
    color: var(--white);
    text-decoration: none;
}

p {
    margin-bottom: 1rem;
}

h1,
h2,
h3 {
    font-family: var(--heading-font);
    line-height: 1.2;
}

h1 {
    font-size: clamp(2.2rem, 5vw, 4rem);
}

h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
}

h3 {
    font-size: 1.4rem;
}


/* =========================================
   CONTAINER
   ========================================= */

.container {
    width: 90%;
    max-width: var(--container-width);
    margin: 0 auto;
}


/* =========================================
   HEADER
   ========================================= */

.site-header {
    background-color: var(--charcoal);
    border-bottom: 1px solid var(--grey);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar {
    width: 90%;
    max-width: var(--container-width);
    margin: 0 auto;

    min-height: 5rem;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 2rem;
}


/* =========================================
   LOGO
   ========================================= */

.logo {
    font-family: var(--heading-font);
    font-size: 1.2rem;
    font-weight: bold;
    letter-spacing: 0.08em;

    display: flex;
    flex-direction: column;
}

.logo span {
    font-family: var(--body-font);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    color: var(--light-grey);
    margin-top: 0.2rem;
}


/* =========================================
   NAVIGATION
   ========================================= */

nav {
    display: block;
}

.nav-links {
    list-style: none;

    display: flex;
    align-items: center;
    gap: 1.5rem;
}

.nav-links a {
    display: block;
    padding: 0.5rem 0;

    color: var(--light-grey);

    font-size: 0.9rem;
    letter-spacing: 0.04em;

    border-bottom: 2px solid transparent;

    transition:
        color 0.3s ease,
        border-color 0.3s ease;
}

.nav-links a:hover {
    color: var(--white);
    border-bottom-color: var(--light-grey);
}

.nav-links a:focus {
    outline: 2px solid var(--light-grey);
    outline-offset: 4px;
}

.nav-links a:active {
    color: var(--white);
}

.nav-links a.active {
    color: var(--white);
    border-bottom-color: var(--white);
}


/* =========================================
   MOBILE MENU BUTTON
   ========================================= */

.menu-toggle {
    display: none;

    background: transparent;
    color: var(--white);

    border: 1px solid var(--light-grey);

    padding: 0.5rem 1rem;

    cursor: pointer;

    font-family: var(--body-font);
}

.menu-toggle:hover {
    background-color: var(--grey);
}

.menu-toggle:focus {
    outline: 2px solid var(--white);
    outline-offset: 3px;
}

.menu-toggle:active {
    transform: scale(0.97);
}


/* =========================================
   PAGE BANNER
   ========================================= */

.page-banner {
    background-color: var(--charcoal);

    padding: 5rem 0;

    text-align: center;

    border-bottom: 1px solid var(--grey);
}

.page-banner p {
    color: var(--light-grey);
    max-width: 650px;
    margin: 1rem auto 0;
}


/* =========================================
   HERO
   ========================================= */

.hero {
    min-height: 70vh;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 5rem 5%;

    background:
        linear-gradient(
            rgba(11, 11, 11, 0.85),
            rgba(11, 11, 11, 0.95)
        );

    border-bottom: 1px solid var(--grey);
}

.hero h2 {
    max-width: 800px;
    margin-bottom: 1.5rem;
}

.hero p {
    max-width: 700px;
    color: var(--light-grey);
}


/* =========================================
   BUTTONS
   ========================================= */

.button,
.btn {
    display: inline-block;

    padding: 0.8rem 1.5rem;

    background-color: var(--white);
    color: var(--black);

    border: 1px solid var(--white);

    font-weight: bold;
    letter-spacing: 0.04em;

    transition:
        background-color 0.3s ease,
        color 0.3s ease,
        transform 0.2s ease;
}

.button:hover,
.btn:hover {
    background-color: var(--light-grey);
    color: var(--black);
    transform: translateY(-2px);
}

.button:focus,
.btn:focus {
    outline: 2px solid var(--light-grey);
    outline-offset: 4px;
}

.button:active,
.btn:active {
    transform: translateY(0);
}


/* =========================================
   SECTIONS
   ========================================= */

.section {
    padding: 5rem 0;
}

.section-heading {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 3rem;
}

.section-heading p {
    color: var(--light-grey);
    margin-top: 1rem;
}


/* =========================================
   SPLIT LAYOUT
   ========================================= */

.split-layout {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 4rem;

    align-items: center;
}

.split-layout img {
    width: 100%;
    max-height: 500px;
    object-fit: contain;

    background-color: var(--charcoal);

    padding: 2rem;

    border: 1px solid var(--grey);
}

.split-layout h2 {
    margin-bottom: 1.5rem;
}

.split-layout p {
    color: var(--light-grey);
}


/* =========================================
   PRODUCT GRID
   ========================================= */

.product-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 2rem;
}


/* =========================================
   PRODUCT CARDS
   ========================================= */

.product-card {
    background-color: var(--charcoal);

    border: 1px solid var(--grey);

    overflow: hidden;

    transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease;
}

.product-card:hover {
    transform: translateY(-6px);

    border-color: var(--light-grey);

    box-shadow:
        0 10px 30px rgba(0, 0, 0, 0.4);
}

.product-card img {
    width: 100%;

    aspect-ratio: 4 / 3;

    object-fit: contain;

    padding: 2rem;

    background-color: var(--black);
}

.product-info {
    padding: 1.5rem;
}

.product-info h3 {
    margin-bottom: 0.8rem;
}

.product-info p {
    color: var(--light-grey);
}

.product-info .price {
    color: var(--white);

    font-weight: bold;

    font-size: 1.1rem;

    margin-top: 1rem;
}


/* =========================================
   IMAGE GALLERY
   ========================================= */

.image-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 2rem;
}

.image-card {
    background-color: var(--charcoal);

    border: 1px solid var(--grey);

    overflow: hidden;

    transition:
        transform 0.3s ease,
        border-color 0.3s ease;
}

.image-card:hover {
    transform: translateY(-5px);

    border-color: var(--light-grey);
}

.image-card img {
    width: 100%;

    aspect-ratio: 4 / 3;

    object-fit: contain;

    padding: 2rem;

    background-color: var(--black);
}

.image-card figcaption {
    padding: 1rem;

    text-align: center;

    font-family: var(--heading-font);

    font-size: 1.2rem;
}


/* =========================================
   SERVICES
   ========================================= */

.service-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 2rem;
}

.service-card {
    background-color: var(--charcoal);

    border: 1px solid var(--grey);

    padding: 2rem;

    transition:
        transform 0.3s ease,
        border-color 0.3s ease;
}

.service-card:hover {
    transform: translateY(-5px);

    border-color: var(--light-grey);
}

.service-card h3 {
    margin-bottom: 1rem;
}

.service-card p {
    color: var(--light-grey);
}


/* =========================================
   FOOTER
   ========================================= */

.site-footer {
    background-color: var(--charcoal);

    border-top: 1px solid var(--grey);

    padding-top: 3rem;
}

.footer-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 3rem;

    padding-bottom: 3rem;
}

.site-footer h3 {
    margin-bottom: 1rem;
}

.site-footer p {
    color: var(--light-grey);
}

.footer-links {
    list-style: none;
}

.footer-links li {
    margin-bottom: 0.5rem;
}

.footer-links a {
    color: var(--light-grey);
}

.footer-links a:hover {
    color: var(--white);
}

.footer-links a:focus {
    outline: 2px solid var(--white);
}

.copyright {
    border-top: 1px solid var(--grey);

    padding: 1.5rem 0;

    text-align: center;
}

.copyright p {
    margin: 0;
    font-size: 0.85rem;
}


/* =========================================
   RESPONSIVE DESIGN
   TABLET
   ========================================= */

@media (max-width: 900px) {

    .navbar {
        flex-wrap: wrap;

        padding: 1rem 0;
    }

    .nav-links {
        gap: 1rem;
    }

    .split-layout {
        grid-template-columns: 1fr;

        gap: 2.5rem;
    }

    .product-grid,
    .image-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .service-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .footer-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }
}


/* =========================================
   RESPONSIVE DESIGN
   MOBILE
   ========================================= */

@media (max-width: 600px) {

    body {
        font-size: 0.95rem;
    }

    .navbar {
        min-height: 4rem;
    }

    .menu-toggle {
        display: block;
    }

    nav {
        width: 100%;
    }

    .nav-links {
        display: none;

        flex-direction: column;

        align-items: stretch;

        gap: 0;

        width: 100%;
    }

    .nav-links.show {
        display: flex;
    }

    .nav-links li {
        border-top: 1px solid var(--grey);
    }

    .nav-links a {
        padding: 0.8rem 0;
    }

    .hero {
        min-height: 60vh;

        padding: 4rem 5%;
    }

    .page-banner {
        padding: 3.5rem 0;
    }

    .section {
        padding: 3.5rem 0;
    }

    .product-grid,
    .image-grid,
    .service-grid,
    .footer-grid {
        grid-template-columns: 1fr;
    }

    .split-layout {
        grid-template-columns: 1fr;
    }

    .split-layout img {
        max-height: 350px;
    }

    .product-card img,
    .image-card img {
        aspect-ratio: 1 / 1;
    }

    .logo {
        font-size: 1rem;
    }

    .logo span {
        font-size: 0.55rem;
    }
}